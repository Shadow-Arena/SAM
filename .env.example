# Copy to .env:  cp .env.example .env   (or run `make env`)
# All variables are optional; defaults are shown.

# ---------------------------------------------------------------- model
# SAM3 Promptable Concept Segmentation model (HF Hub ID or local path)
SAM_MODEL_ID=facebook/sam3
# SAM3 tracker (points) — defaults to SAM_MODEL_ID
# SAM_TRACKER_MODEL_ID=facebook/sam3
SAM_DEVICE=auto            # auto | cpu | cuda | mps | xpu
SAM_DTYPE=auto             # auto | float32 | float16 | bfloat16
SAM_USE_SAFETENSORS=true
SAM_LOW_CPU_MEM_USAGE=true
SAM_LOCAL_FILES_ONLY=false
SAM_LAZY_LOAD=true         # load model on first request instead of startup

# ------------------------------------------------------------ thresholds
SAM_SCORE_THRESHOLD=0.30
SAM_MASK_THRESHOLD=0.50
SAM_IOU_MERGE_THRESHOLD=0.70
SAM_MAX_MASKS=100
SAM_MASK_OPACITY=0.55

# ---------------------------------------------------------- annotations
SAM_POINT_MAX_SIZE_PX=32
SAM_POINT_MAX_SIZE_RELATIVE=0.05
SAM_CLUSTER_DISTANCE_PX=48
SAM_NEGATIVE_POINT_BOX_SIZE_RELATIVE=0.04
SAM_MIN_COMPONENT_AREA=6
# SAM_UNKNOWN_COLOR_LABEL=positive

# ------------------------------------------------------------------- ui
SAM_HOST=0.0.0.0
SAM_PORT=7860
SAM_SHARE=false
# SAM_GRADIO_AUTH=user:password
# SAM_GRADIO_ROOT_PATH=/sam
SAM_QUEUE_CONCURRENCY=2
SAM_MAX_FILE_SIZE=200mb
SAM_OUTPUT_DIR=outputs

# ------------------------------------------------------------- hf hub
# Required for gated/private checkpoints (e.g. facebook/sam3).
# Get a token at https://huggingface.co/settings/tokens
# The token is read from .env — either form works:
SAM_HF_TOKEN=hf_xxx
# HF_TOKEN=hf_xxx
# When set, the app calls huggingface_hub.login(token) at startup and exports
# it as HF_TOKEN / HUGGINGFACEHUB_API_TOKEN (so transformers uses it too).
# Set to false if you prefer logging in once interactively: make login
# SAM_HF_LOGIN=true
# Use a mirror if huggingface.co is unreachable from your network:
# SAM_HF_ENDPOINT=https://hf-mirror.com
# HF_ENDPOINT=https://hf-mirror.com

# ------------------------------------------------------------- misc
# SAM_MOCK=false          # true = no model download; synthetic results (dev/tests)
SAM_LOG_LEVEL=INFO
